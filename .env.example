# Startkontor: Umgebungsvariablen. Kopieren nach .env.local (Entwicklung) oder in die Umgebung des Hosters (Betrieb).
# Niemals mit echten Werten einchecken.

# Öffentliche Adresse der Website, ohne Schrägstrich am Ende. Für Canonical, Sitemap und Mails.
SITE_URL=https://startkontor.de

# Resend (E-Mail Versand und Kontakte für den Monatsbrief)
RESEND_API_KEY=
# Absender, zum Beispiel: Startkontor <redaktion@ihre-domain.example>. Die Domain muss bei Resend verifiziert sein.
MAIL_FROM="Startkontor <newsletter@startkontor.de>"
# Postfach der Redaktion für das Kontaktformular
MAIL_TO=newsletter@startkontor.de
# ID der Resend Audience, in der bestätigte Abonnenten landen
NEWSLETTER_AUDIENCE_ID=

# Geheimnis für die Bestätigungs und Abmeldelinks, mindestens 32 zufällige Bytes.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEWSLETTER_SECRET=

# Nur für lokale Tests des Launch Gates und der Prüfungen: eine Datei aus config/ mit Testwerten.
# Nie für den Betrieb verwenden. Beispiel: BETREIBER_DATEI=betreiber.test.json
# BETREIBER_DATEI=
